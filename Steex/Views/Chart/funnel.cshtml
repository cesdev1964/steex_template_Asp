@{
    ViewBag.Title = "Funnel Charts";
    ViewBag.pTitle = "Area Charts";
    ViewBag.pageTitle = "Funnel Charts";

}

<div class="row">
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Funnel Chart</h4>
            </div><!-- end card header -->

            <div class="card-body">
                <div id="funnel_chart" data-colors='["--tb-primary"]' class="apex-charts" dir="ltr"></div>
            </div><!-- end card-body -->
        </div><!-- end card -->
    </div>
    <!-- end col -->

    <div class="col-xl-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Pyramid Chart</h4>
            </div><!-- end card header -->

            <div class="card-body">
                <div id="pyramidChart" data-colors='["--tb-primary", "--tb-secondary", "--tb-success", "--tb-warning", "--tb-info", "--tb-danger"]' class="apex-charts" dir="ltr"></div>
            </div><!-- end card-body -->
        </div><!-- end card -->
    </div>
    <!-- end col -->
</div>
<!-- end row -->
@section scripts{
    <!-- apexcharts -->
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>

    <!-- barcharts init -->
    <script src="~/assets/js/pages/apexcharts-funnel.init.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}